#!/usr/bin/env bash
# dm-secure — local launcher for the DM SecureGate scanner.
#
# Works WITHOUT a pip install: it puts the bundled Python package on PYTHONPATH
# and runs `python3 -m dm_secure` from YOUR current directory (so `dm-secure ui`
# scans the repo you're standing in). For a true global command, run
# `pip install -e ./cli` or `pip install dm-secure-gate` (provides the
# `dm-secure` console script).
#
# Usage:  dm-secure ./path/to/repo [-o report.json]
#         dm-secure ui                 # launch the local dashboard (scans cwd)
set -euo pipefail

# Resolve this script's directory (cli/bin -> cli).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"          # .../cli

# Prefer a venv if one was created beside the cli dir, else system python3.
for py in "$CLI_DIR/.venv/bin/python" "$CLI_DIR/../.venv/bin/python" python3; do
  if command -v "$py" >/dev/null 2>&1; then PY="$py"; break; fi
done

# Run from the USER's current directory so the dashboard scans the right repo;
# CLI_DIR is added to PYTHONPATH so the `dm_secure` package is importable.
export PYTHONPATH="$CLI_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m dm_secure "$@"
